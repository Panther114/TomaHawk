{
  "name": "tomahawk",
  "version": "1.0.0",
  "private": true,
  "description": "Tomahawk — a deterministic, local-first modern joint-warfare sandbox.",
  "license": "LicenseRef-PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --max-old-space-size=64 server.mjs",
    "refresh:start": "node scripts/build-east-china-sea-map.mjs && node server.mjs",
    "test": "node scripts/run-tests.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:server": "node scripts/bench-server.mjs",
    "bench:terrain": "node scripts/bench-terrain.mjs",
    "bench:frontend": "node scripts/bench-frontend.mjs",
    "font:ui": "node scripts/build-ui-font.mjs",
    "debug:sim": "node --expose-gc scripts/sim-debug.mjs",
    "map:data": "node scripts/build-east-china-sea-map.mjs",
    "screenshot:equipment": "node scripts/screenshot-equipment.mjs",
    "screenshot:docs": "node scripts/screenshot-docs.mjs"
  },
  "devDependencies": {
    "playwright": "1.62.0"
  }
}
